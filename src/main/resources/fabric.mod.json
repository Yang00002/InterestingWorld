{
  "schemaVersion": 1,
  "id": "iw",
  "version": "${version}",
  "name": "InterestingWorld",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/iw/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.yang.iw.datagen.IWDataGen"
    ],
    "client": [
      "org.yang.iw.client.IWClient"
    ],
    "main": [
      "org.yang.iw.IWMain"
    ]
  },
  "mixins": [
    "iw.mixins.json",
    {
      "config": "iw.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/entity/LivingEntity": [
        "org/yang/iw/mixin/mixin_interface/InterfaceLivingEntity"
      ],
      "net/minecraft/entity/effect/StatusEffect": [
        "org/yang/iw/mixin/mixin_interface/InterfaceStatusEffect"
      ],
      "net/minecraft/entity/effect/StatusEffectInstance": [
        "org/yang/iw/mixin/mixin_interface/InterfaceStatusEffectInstance"
      ],
      "net/minecraft/server/network/ServerPlayerEntity": [
        "org/yang/iw/mixin/mixin_interface/InterfaceServerPlayerEntity"
      ],
      "net/minecraft/client/network/ClientPlayerEntity": [
        "org/yang/iw/mixin/mixin_interface/InterfaceClientPlayerEntity"
      ],
      "net/minecraft/client/data/Model": [
        "org/yang/iw/mixin/mixin_interface/InterfaceModel"
      ],
      "net/minecraft/client/gui/tooltip/OrderedTextTooltipComponent": [
        "org/yang/iw/mixin/mixin_interface/InterfaceOrderedTextTooltipComponent"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
