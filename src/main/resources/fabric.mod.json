{
  "schemaVersion": 1,
  "id": "interestingworld",
  "version": "${version}",
  "name": "InterestingWorld",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/interestingworld/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.yang.interestingworld.datagen.IWDataGen"
    ],
    "client": [
      "org.yang.interestingworld.client.InterestingworldClient"
    ],
    "main": [
      "org.yang.interestingworld.Interestingworld"
    ]
  },
  "mixins": [
    "interestingworld.mixins.json",
    {
      "config": "interestingworld.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/entity/LivingEntity": [
        "org/yang/interestingworld/mixin_interface/InterfaceLivingEntity"
      ],
      "net/minecraft/entity/effect/StatusEffect": [
        "org/yang/interestingworld/mixin_interface/InterfaceStatusEffect"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
